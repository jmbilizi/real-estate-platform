legacy-peer-deps=true
auto-install-peers=true
strict-peer-dependencies=false

# Suppress npm's own output — accidental npm commands are redirected to pnpm
# by the preinstall hook (tools/node/scripts/ensure-pnpm.js). npm's error
# summary after the hook exits is misleading, so silence it.
loglevel=silent

# Prevent npm from creating package-lock.json (pnpm-lock.yaml is the lockfile).
package-lock=false
