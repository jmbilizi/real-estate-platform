# ── API Gateway ────────────────────────────────────────────────────────────────
# Server-side only (NOT NEXT_PUBLIC_). Used by Next.js API routes to reach
# the API gateway. Never exposed to the browser.
#
# Local dev (standalone Next.js): leave unset → defaults to http://localhost:8080
# K8s cluster:                    set via deployment env var (see infra/k8s/)
#
# API_GATEWAY_URL=http://localhost:8080

# Dev gateway access for frontend-only work (see AGENTS.md 'Frontend-only work')
# API_GATEWAY_URL=https://dev-gateway.example.invalid
# API_GATEWAY_BASIC_AUTH=devuser:devpassword

# ── Google sign-in ─────────────────────────────────────────────────────────────
# OAuth client ID (type Web application) for "Continue with Google" (#1049). Public.
# Unset: the button stays hidden. Add http://localhost:3000 as an authorized JavaScript
# origin. Use the same value as ACCOUNT_SERVICE_GOOGLE_CLIENT_ID in the root .env.
# GOOGLE_CLIENT_ID=
