{
  "ConnectionStrings": {
    "AccountDb": "Host=postgres-svc;Port=5432;Database=account_db;Username=account_service_db_user;Password=StrongBase64Password"
  },
  "Apps": {
    "AllowedApps": ["cribstop", "admin-portal"]
  },
  "AccountRecovery": {
    "RequireConfirmedEmail": false,
    "ConfirmationPath": "/confirm-email",
    "PasswordResetPath": "/reset-password",
    "ConfirmationTokenLifetime": "1.00:00:00",
    "TokenLifetime": "01:00:00",
    "ResendMinimumInterval": "00:01:00",
    "ResendsPerEmailPerHour": 3,
    "ResendsPerEmailPerDay": 10,
    "RequestsPerEmail": 5,
    "ResendsPerAddress": 10,
    "RequestsPerAddress": 15,
    "RedemptionsPerAddress": 30,
    "RegistrationsPerAddress": 30,
    "RequestWindow": "00:15:00",
    "MaxTrackedKeys": 50000,
    "MinimumResponseDuration": "00:00:00.250"
  },
  "Email": {
    "FromName": "Cribstop (Real Broker, LLC)",
    "FromAddress": "no-reply@cribstop.com",
    "ReplyToAddress": "contact@cribstop.com",
    "BrokerageDisclosure": "Cribstop is brokered by Real Broker, LLC."
  },
  "EmailCodes": {
    "CodeLength": 6,
    "Lifetime": "00:10:00",
    "MaxWrongTries": 5,
    "LockDuration": "00:15:00",
    "FailureWindow": "1.00:00:00",
    "ResendCooldown": "00:01:00",
    "MaxPerHour": 5,
    "MaxPerDay": 10,
    "PurgeInterval": "00:15:00"
  },
  "PasswordPolicy": {
    "MinLength": 15,
    "MaxLength": 128,
    "BreachCheckEnabled": true,
    "BreachCheckBaseUrl": "https://api.pwnedpasswords.com/",
    "BreachCheckTimeout": "00:00:02"
  },
  "Postmark": {
    "MessageStream": "outbound"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
