# Copy to .env (git-ignored) and adjust for your local environment.
#
# property_db is already provisioned in infra (not created by this service):
# see infra/k8s/base/configmaps/postgres.configmap.yaml and
# infra/k8s/base/secrets/postgres.secret.yaml (PROPERTY_SERVICE_DB_USER_PASSWORD).
# The password below matches the placeholder already checked into that secret
# manifest for local/dev use — replace it for any non-local environment.
DATABASE_URL=postgresql://property_service_db_user:StrongBase64Password@localhost:5432/property_db

