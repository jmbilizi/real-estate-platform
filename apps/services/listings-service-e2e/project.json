{
  "name": "listings-service-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["listings-service"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/services/listings-service-e2e/jest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["listings-service:build", "listings-service:serve"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint --config tools/node/configs/eslint.config.js apps/services/listings-service-e2e",
        "cwd": "."
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p apps/services/listings-service-e2e/tsconfig.json",
        "cwd": "."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write .",
        "cwd": "apps/services/listings-service-e2e"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check .",
        "cwd": "apps/services/listings-service-e2e"
      }
    },
    "test": {
      "executor": "nx:noop",
      "metadata": {
        "description": "Intentional no-op. This project holds no unit tests — its suite is the 'e2e' target, which boots listings-service first. A jest 'test' target here would run the e2e spec without a server and fail CI's nx:node-test sweep. Defined explicitly (rather than omitted) because tools/nx/setup-standard-targets.js re-adds a jest test target to any Node project missing one."
      }
    }
  },
  "tags": [
    "runtime:node",
    "type:service",
    "framework:unassigned",
    "scope:unassigned",
    "devteam:unassigned"
  ]
}
