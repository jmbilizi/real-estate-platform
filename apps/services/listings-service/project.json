{
  "name": "listings-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/listings-service/src",
  "projectType": "application",
  "tags": [
    "runtime:node",
    "type:service",
    "framework:unassigned",
    "scope:unassigned",
    "devteam:unassigned"
  ],
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/services/listings-service/package.json",
        "{workspaceRoot}/dist/apps/services/listings-service/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/services/listings-service/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "listings-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "listings-service:build:development"
        },
        "production": {
          "buildTarget": "listings-service:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint --config tools/node/configs/eslint.config.js apps/services/listings-service",
        "cwd": "."
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p apps/services/listings-service/tsconfig.json",
        "cwd": "."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write .",
        "cwd": "apps/services/listings-service"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check .",
        "cwd": "apps/services/listings-service"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node-pg-migrate up --envPath .env",
        "cwd": "apps/services/listings-service"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node-pg-migrate down --envPath .env",
        "cwd": "apps/services/listings-service"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -P tsconfig.app.json src/seed/seed.ts",
        "cwd": "apps/services/listings-service"
      }
    }
  }
}
