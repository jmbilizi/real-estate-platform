{
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "Too many requests. Please try again later.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Real-IP"
    },
    "QoSOptions": {
      "Timeout": 10000,
      "MinimumThroughput": 5,
      "FailureRatio": 0.5,
      "SamplingDuration": 30000,
      "BreakDuration": 10000
    }
  },
  "Routes": [],
  "SwaggerEndPoints": []
}
