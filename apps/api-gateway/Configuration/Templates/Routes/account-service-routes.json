          "Host": "localhost",
          "Port": 7072
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/account/logout",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/api/account/logout",
