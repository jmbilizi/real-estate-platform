      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 3002
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/listings/{id}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/listings/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 3002
