{
  "ServiceName": "Property",
  "Active": true,
  "SwaggerEndPoints": [
    {
      "Key": "Property",
      "Config": [
        {
          "Name": "Property API",
          "Version": "v1",
          "Url": "/swagger/docs/v1"
        }
      ]
    }
  ],
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/listings/meta",
