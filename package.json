{
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "nx",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/dotnet": "22.0.1",
    "@nx/eslint": "22.0.1",
    "@nx/expo": "22.0.1",
    "@nx/express": "22.0.1",
    "@nx/jest": "22.0.1",
    "@nx/js": "22.0.1",
    "@nx/next": "22.0.1",
    "@nx/node": "22.0.1",
    "@nxlv/python": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@swc-node/register": "~1.9.2",
    "@swc/core": "~1.7.26",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "baseline-browser-mapping": "^2.10.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.1.1",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.1.5",
    "nx": "22.0.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "prettify-xml": "^1.2.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "// Getting Started": "",
    "// → First time setup:  pnpm run hooks:setup": "",
    "// → Python dev:        pnpm run python:env:full": "",
    "// → .NET dev:          pnpm run dotnet:env": "",
    "// → Local cluster:     pnpm run infra:local:cluster:setup": "",
    "// → Local development: pnpm run skaffold": "",
    "// Git Hooks": "",
    "hooks:setup": "node tools/hooks/setup-hooks.js",
    "// NX Workspace Extensions": "",
    "// Workspace Management": "",
    "clean": "pnpm run nx:reset && rimraf dist node_modules/.cache",
    "// Quality Checks": "",
    "pre-commit": "node scripts/pre-commit.js",
    "pre-push": "node scripts/pre-push.js",
    "// NX Core Commands": "",
    "nx:repair": "node tools/nx/repair-nx.js",
    "nx:reset": "pnpm run nx:repair && nx reset && node tools/nx/setup-workspace-targets.js && node tools/nx/auto-tag-projects.js",
    "nx:tag-projects": "node tools/nx/auto-tag-projects.js",
    "nx:graph": "pnpm run nx:reset && nx graph",
    "// → Usage: pnpm run nx:run-many -- --target=build --projects=tag:runtime:node / --projects=proj1,proj2": "",
    "nx:run-many": "pnpm run nx:reset && node tools/nx/safe-run-many.js",
    "nx:affected": "pnpm run nx:reset && nx affected",
    "nx:list-projects": "nx show projects",
    "nx:workspace-format": "prettier --write --ignore-unknown .",
    "nx:workspace-format-check": "prettier --check --ignore-unknown .",
    "// Node.js": "",
    "node:help": "node tools/node/scripts/node-help.js",
    "node:check-version": "node tools/node/scripts/check-node-version.js",
    "node:apply-configs": "node tools/node/scripts/apply-node-configs.js",
    "nx:node-dev": "pnpm run nx:reset && node tools/nx/safe-run-many.js --target=serve --projects=tag:runtime:node",
    "nx:node-build": "node tools/nx/safe-run-many.js --target=build --projects=tag:runtime:node",
    "nx:node-test": "node tools/nx/safe-run-many.js --target=test --projects=tag:runtime:node",
    "nx:node-lint": "node tools/nx/safe-run-many.js --target=lint --projects=tag:runtime:node",
    "nx:node-type-check": "node tools/nx/safe-run-many.js --target=type-check --projects=tag:runtime:node",
    "nx:node-format": "node tools/nx/safe-run-many.js --target=format --projects=tag:runtime:node",
    "nx:node-format-check": "node tools/nx/safe-run-many.js --target=format-check --projects=tag:runtime:node",
    "// .NET": "",
    "dotnet:env": "node tools/dotnet/scripts/dotnet-dev-setup.js",
    "dotnet:restore": "node tools/dotnet/scripts/dotnet-packages.js",
    "dotnet:restore:project": "node tools/dotnet/scripts/dotnet-packages.js install",
    "dotnet:help": "node tools/dotnet/scripts/dotnet-help.js",
    "dotnet:setup-projects": "node tools/dotnet/scripts/setup-dotnet-projects.js",
    "nx:dotnet-dev": "pnpm run nx:reset && node tools/nx/safe-run-many.js --target=serve --projects=tag:runtime:dotnet",
    "nx:dotnet-build": "node tools/nx/safe-run-many.js --target=build --projects=tag:runtime:dotnet",
    "nx:dotnet-test": "node tools/nx/safe-run-many.js --target=test --projects=tag:runtime:dotnet",
    "nx:dotnet-lint": "node tools/nx/safe-run-many.js --target=lint --projects=tag:runtime:dotnet",
    "nx:dotnet-type-check": "node tools/nx/safe-run-many.js --target=type-check --projects=tag:runtime:dotnet",
    "nx:dotnet-format": "node tools/nx/safe-run-many.js --target=format --projects=tag:runtime:dotnet",
    "nx:dotnet-format-check": "node tools/nx/safe-run-many.js --target=format-check --projects=tag:runtime:dotnet",
    "// Python": "",
    "python:env": "node tools/python/scripts/python-dev-setup.js",
    "python:env:full": "node tools/python/scripts/python-dev-setup.js --all-extras",
    "python:format": "uv run black . --exclude \"(/\\.venv/|/node_modules/|/\\.git/|/\\.nx/|/__pycache__/|/dist/|/build/)\"",
    "python:lint": "uv run flake8 . --config=tools/python/.flake8 && uv run mypy . --config-file=tools/python/mypy.ini",
    "python:check": "pnpm run python:format && pnpm run python:lint",
    "nx:python-dev": "pnpm run nx:reset && node tools/nx/safe-run-many.js --target=serve --projects=tag:runtime:python",
    "nx:python-build": "node tools/nx/safe-run-many.js --target=build --projects=tag:runtime:python",
    "nx:python-test": "node tools/nx/safe-run-many.js --target=test --projects=tag:runtime:python",
    "nx:python-lint": "node tools/nx/safe-run-many.js --target=lint --projects=tag:runtime:python",
    "nx:python-format": "node tools/nx/safe-run-many.js --target=format --projects=tag:runtime:python",
    "nx:python-format-check": "node tools/nx/safe-run-many.js --target=format-check --projects=tag:runtime:python",
    "nx:python-type-check": "node tools/nx/safe-run-many.js --target=type-check --projects=tag:runtime:python",
    "// Infrastructure": "",
    "infra:setup": "node tools/infra/setup-infra.js",
    "infra:validate": "node tools/infra/validate-kustomize.js",
    "infra:validate:dev": "node tools/infra/validate-kustomize.js dev",
    "infra:validate:test": "node tools/infra/validate-kustomize.js test",
    "infra:validate:prod": "node tools/infra/validate-kustomize.js prod",
    "// GeoIP Database (Optional)": "",
    "// → One-command setup: pnpm run geoip:download": "",
    "// → Requires:          MAXMIND_LICENSE_KEY env var (free at maxmind.com)": "",
    "geoip:download": "node tools/infra/download-geoip.js",
    "// Container Operations": "",
    "container:build": "node tools/docker/build-image.js",
    "container:build:all": "pnpm run nx:reset && node tools/nx/run-many-with-target.js --target=container-build",
    "container:build:affected": "pnpm run nx:reset && pnpm exec nx affected --target=container-build",
    "// Local Cluster Lifecycle": "",
    "infra:local:cluster:setup": "node tools/infra/setup-local-cluster.js",
    "infra:local:cluster:delete": "node tools/infra/delete-local-cluster.js",
    "infra:local:cluster:reset:disk": "node tools/infra/dev-reset-disk.js",
    "infra:local:cluster:images:list": "node tools/infra/list-kind-images.js",
    "// Local Container Registry": "",
    "infra:local:registry:ensure": "node tools/infra/local-registry.js ensure",
    "infra:local:registry:status": "node tools/infra/local-registry.js status",
    "infra:local:registry:delete": "node tools/infra/local-registry.js delete",
    "// Local Kubernetes Development": "",
    "// → Skip build:        pnpm run skaffold:deploy -- --skip-build": "",
    "// → No cache:          pnpm run skaffold:deploy -- --cache-artifacts=false": "",
    "// → Both:              pnpm run skaffold:deploy -- --skip-build --cache-artifacts=false": "",
    "skaffold": "node tools/infra/run-skaffold.js dev --port-forward",
    "skaffold:debug": "node tools/infra/run-skaffold.js debug --port-forward",
    "skaffold:build": "node tools/infra/run-skaffold.js build --cache-artifacts=false",
    "skaffold:deploy": "node tools/infra/run-skaffold.js run --port-forward --tail",
    "skaffold:delete": "node tools/infra/run-skaffold.js delete",
    "// Server Apps (Gateway & Services)": "",
    "gateway:serve": "nx serve api-gateway",
    "account:serve": "nx serve account-service",
    "inference:serve": "nx serve multi-model-inference",
    "// Client Apps (Web & Mobile)": "",
    "cribstop:web": "nx serve cribstop-next"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix --config tools/node/configs/eslint.config.js",
      "prettier --write --config tools/node/configs/prettier-config.js"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.{py,pyx,pxd,pxi,pyi}": [
      "uv run black",
      "uv run flake8 --config=tools/python/.flake8",
      "uv run mypy --config-file=tools/python/mypy.ini"
    ],
    "*.ipynb": [
      "uv run black"
    ],
    "*.{cs,vb}": [
      "dotnet format"
    ],
    "*.sql": [
      "uv run sqlfluff fix --dialect ansi --config=tools/python/.sqlfluff"
    ],
    "*.{yml,yaml}": [
      "uv run yamllint -c tools/python/.yamllint"
    ],
    "*.{xml,csproj,sqlproj}": [
      "pnpm exec prettify-xml"
    ]
  },
  "dependencies": {
    "nextjs-toploader": "^3.9.17"
  }
}
