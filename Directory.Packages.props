<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 
    Central Package Management for NuGet
    This file defines package versions used across all projects in the monorepo.
    See: https://learn.microsoft.com/nuget/consume-packages/central-package-management
    
    IMPORTANT NOTES:
    
    1. VersionOverride: Used to force a specific version even when transitive dependencies
       try to pull in different versions. Helps avoid security vulnerabilities and conflicts.
       
    2. NU1604 Warnings: If you see "does not contain an inclusive lower bound" warnings,
       you have two options:
       a) Add explicit Version in the project's .csproj file
       b) Use version ranges here like Version="[13.0.3,)" for lower bound only
       
    3. Shared vs Project-Specific Packages:
       - Define shared packages here (used by multiple projects)
       - Keep project-specific packages in individual .csproj files with explicit versions
       
    4. Transitive Dependencies: If a package pulls in an old version of a dependency,
       add that dependency here with VersionOverride to force the correct version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Enables VersionOverride attribute to force specific versions -->
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- Common packages used across projects -->
  <ItemGroup>
    <!-- Runtime packages -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.1" />

    <!-- Data access packages -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <!-- VersionOverride: pins transitive dependency to avoid CVE-2024-43483 (DoS vulnerability fixed in 8.0.1+) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" VersionOverride="9.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.28" />

    <!-- API packages -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <!-- VersionOverride: pins transitive dependency to fix GHSA-v5pm-xwqc-g5wc (high severity vulnerability in 2.x) -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.8.0" VersionOverride="3.8.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.1" />
    <PackageVersion Include="MMLib.SwaggerForOcelot" Version="10.0.0" />
    <PackageVersion Include="Ocelot" Version="24.1.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.8" />
    
    <!-- OpenTelemetry packages (1.15.3 patches GHSA-4625-4j76-fww9, GHSA-mr8r-92fq-pj8p, GHSA-q834-8qmm-v933) -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.10.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    
    <!-- Geolocation packages -->
    <PackageVersion Include="MaxMind.GeoIP2" Version="5.4.1" />
    
    <!-- Configuration packages -->
    <PackageVersion Include="DotNetEnv" Version="3.1.1" />

    <!-- Testing packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />

    <!-- Utilities -->
    <!-- VersionOverride forces version 13.0.3 even if transitive dependencies try to use older versions (e.g., 3.5.8) -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" VersionOverride="13.0.3" />
    <PackageVersion Include="Newtonsoft.Json.Bson" Version="1.0.2" />
    <PackageVersion Include="AutoMapper" Version="13.0.1" />
    <PackageVersion Include="Serilog" Version="3.1.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Code analysis packages -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.507" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.102" />
  </ItemGroup>
</Project>