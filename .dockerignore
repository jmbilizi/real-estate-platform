# Node
# Use **/ glob to exclude nested node_modules too (e.g. apps/clients/cribstop/next/node_modules/).
# Without **/,  only the root-level node_modules/ is excluded, causing COPY of app source
# to overwrite the Linux symlinks set up by the deps stage with broken Windows host symlinks.
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Nx
.nx/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.pytest_cache/
.tox/

# .NET build outputs
**/bin/
**/obj/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Git
.git/

# IDEs
.idea/
.history/
.vs/
.vscode/

# Env files
.env
.env.*.local

# Test projects (companion Tests/ folders inside app directories)
**/Tests/

# Test outputs
coverage/
TestResults/

# Temporary files
tmp/
temp/
*.tmp
*.log

# Next.js build output — must not be in context; builder stage does the build
**/.next/

# Other build artifacts
dist/
