{
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "expo-next/*": ["./libs/expo-next/*"],
      "expo-next": ["./libs/expo-next/index.ts"],
      "shared-next/*": ["./libs/next/*"],
      "shared-next": ["./libs/next/index.ts"],
      "shared-expo/*": ["./libs/expo/*"],
      "shared-expo": ["./libs/expo/index.ts"],
      "platform-shared/*": ["./apps/clients/platform/shared/*"],
      "platform-shared": ["./apps/clients/platform/shared/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", ".nx"],
  "references": []
}
