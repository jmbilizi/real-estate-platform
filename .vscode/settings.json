{
  "chat.agentFilesLocations": {
    ".agents/agents": true
  },
  "chat.agentSkillsLocations": {
    ".agents/skills": true,
    "apps/clients/cribstop/.agents/skills": true
  },
  "chat.useNestedAgentsMdFiles": true,
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/apps", "${workspaceFolder}/libs"],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true
  },
  "sqltools.connections": [
    {
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "askForPassword": true,
      "driver": "PostgreSQL",
      "database": "property_db",
      "username": "property_service_db_user",
      "name": "property_db"
    },
    {
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "askForPassword": true,
      "driver": "PostgreSQL",
      "database": "account_db",
      "username": "account_service_db_user",
      "name": "account_db connection"
    }
  ]
}
