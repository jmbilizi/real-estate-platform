{
  "name": "@cribstop/gateway-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gateway-contracts/src",
  "projectType": "library",
  "tags": ["runtime:node", "type:lib", "framework:zod", "scope:shared", "devteam:unassigned"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/gateway-contracts",
        "main": "libs/gateway-contracts/src/index.ts",
        "tsConfig": "libs/gateway-contracts/tsconfig.lib.json",
        "assets": ["libs/gateway-contracts/*.md"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint --config tools/node/configs/eslint.config.js libs/gateway-contracts",
        "cwd": "."
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.json",
        "^production"
      ],
      "options": {
        "command": "tsc -b --noEmit libs/gateway-contracts/tsconfig.json",
        "cwd": "."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write .",
        "cwd": "libs/gateway-contracts"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check .",
        "cwd": "libs/gateway-contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "jest --passWithNoTests",
        "cwd": "libs/gateway-contracts"
      }
    }
  }
}
