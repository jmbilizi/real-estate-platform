            "schema": {
              "description": "Two-letter state code, case-insensitive exact match (e.g. \`MD\`). ANDed with every other filter, including \`query\` — no parameter suppresses another. Full state names are the client’s job to normalize before sending this parameter.",
              "pattern": "^[A-Za-z]{2}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "listingType",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "sale",
                "rent",
                "sold",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "propertyType",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values: Single Family, Condo, Townhome, Multi-Family, Loft, Land, New Construction, Manufactured/Mobile. 'all' means every type.",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Active, Coming Soon, Pending. Default when omitted or empty: Active, Coming Soon. 'Pending' means "Under Contract" to consumers. It covers both the Active Under Contract and Pending MLS statuses. Sold is not a value here. No sold listing publishes in search yet.",
            },
          },
          {
            "in": "query",
            "name": "minPrice",
            "required": false,
            "schema": {
              "description": "Whole number. A listing with a seller-suppressed price never matches this filter, because it has no price to compare.",
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "description": "Whole number. A listing with a seller-suppressed price never matches this filter, because it has no price to compare.",
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "beds",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "baths",
            "required": false,
            "schema": {
              "pattern": "^\\d+(\\.5)?$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minSqft",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "neighborhood",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "officeKey",
            "required": false,
            "schema": {
              "description": "The listing office, by its MLS office key. A drill-down from a broker group, not a search box. \`unlisted\` matches the listings that carry no office key. It is an exact match, ANDed with every other filter.",
              "pattern": "^(\\d{1,19}|unlisted)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "county",
            "required": false,
            "schema": {
              "description": "A 5-digit county FIPS code, matched exactly (case-insensitive) against county_fips. ANDed with every other filter. A caller without a FIPS code should send \`boundary\` instead — this and \`boundary\` should not both be sent for the same conceptual place.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "boundary",
            "required": false,
            "schema": {
              "description": "GeoJSON Polygon or MultiPolygon, as a JSON string, simplified client-side. ANDs with \`neighborhood\` when both are sent. Capped at 500 points and 20000 characters.",
              "maxLength": 20000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "area",
            "required": false,
            "schema": {
              "description": "A drawn shape: GeoJSON Polygon as a JSON string, one closed ring. Only listings inside it match. ANDed with every other filter, including \`boundary\` and \`bounds\`. A listing whose street address is withheld has no coordinates and never matches. Capped at 200 points, 8000 characters and 20 degrees across. A self-intersecting or zero-area shape is a 400.",
              "maxLength": 8000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "bounds",
            "required": false,
            "schema": {
              "description": "Viewport as \`west,south,east,north\` in decimal degrees. West must be less than east and south less than north. A listing whose seller withheld the address has no coordinates, so it never matches a viewport.",
              "pattern": "^-?\\d+(\\.\\d+)?(,-?\\d+(\\.\\d+)?){3}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "openHouse",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "newConstruction",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "waterfront",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "petFriendly",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "explode": false,
            "in": "query",
            "name": "amenities",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Pool, Garage, Gym, Elevator, Balcony, Fireplace, Washer/Dryer, Pet Friendly, Waterfront, Office, Rooftop, Garden, Smart Home, Solar, EV Charging.",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "listedWithinDays",
            "required": false,
            "schema": {
              "description": "Whole number, 1 to 30. Matches a listing whose listed_at is within this many days of now. A listing with no listed_at (the feed carried no list date) never matches.",
              "pattern": "^([1-9]|[12][0-9]|30)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "priceReduced",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minCount",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 1000. Default 1. A group with fewer listings is omitted. A value above 1 makes the group counts add up to less than \`listingTotal\`.",
              "pattern": "^([1-9]\\d{0,2}|1000)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 100. Default 24.",
              "pattern": "^([1-9][0-9]?|100)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "description": "Whole number from 0 to 10000. Default 0. Skips this many groups in the order given by \`order\`. \`total\` stays the exact group count.",
              "pattern": "^\\d{1,5}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "count",
              "description": "\`count\` (default): listing count descending. \`name\`: name ascending. Ties break by \`key\`. No other order exists.",
              "enum": [
                "count",
                "name",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZipsResponse",
                },
              },
            },
            "description": "ZIP code groups with a listing count at or above minCount.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unknown or invalid query parameter (\`invalid_request\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "ZIP code groups",
      },
    },
    "/listings/{id}": {
      "get": {
        "description": "Returns the object graph. \`unit\` is null for a non-subdivided home — meaningful, not missing. Unknown, removed and seller-suppressed listings are indistinguishable.",
        "operationId": "getListing",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingDetail",
                },
              },
            },
            "description": "The listing.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such listing.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "Listing detail",
      },
    },
    "/listings/{id}/card": {
      "get": {
        "description": "Returns the one card row that search returns for this listing, with the same address suppression. A map pin for a listing outside the current results page renders its popup card from this. Unknown, removed and seller-suppressed listings are indistinguishable.",
        "operationId": "getListingCard",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingCardRow",
                },
              },
            },
            "description": "The listing card.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such listing.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "Listing card",
      },
    },
    "/listings/{id}/inquiries": {
      "post": {
        "description": "Needs a signed-in account with a confirmed email. A request with no valid credential gets 401 and no listing data. An account with an unconfirmed email gets 403. The server takes the contact email from the account and ignores \`name\` and \`email\` if the body sends them. \`consentTextVersion\` is required for new clients. With \`consentToContact\` true and no version, the server records \`v1\`. \`phone\` is optional. \`consentToContact\` records that the consumer agreed to be contacted. The server stores the consent text for \`consentTextVersion\`, the \`consentChannels\` and the time. The record starts in the \`new\` lead status. No public read endpoint returns it.

Rate-limited per client and per listing; a request over either limit gets 429 with a \`Retry-After\` header.",
        "operationId": "createListingInquiry",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingInquiryRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingInquiryResponse",
                },
              },
            },
            "description": "The inquiry was recorded.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unknown field, or \`message\` missing/empty when \`kind\` is \`message\`.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The account email is not confirmed (\`forbidden\`).",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such listing, or not publishable through \`listing_search_v\`.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Rate limit exceeded for this client or this listing. Documented here — unlike the read endpoints above — because this limit is enforced by the service itself (keyed on the path parameter), not by the gateway.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Submit a message or tour request against a listing",
      },
    },
    "/listings/{id}/page": {
      "get": {
        "description": "Returns the same page as /properties/{id}/page for the home of this listing. A client uses canonicalPath to redirect an old /listing/<id> URL.",
        "operationId": "getListingPropertyPage",
        "parameters": [
