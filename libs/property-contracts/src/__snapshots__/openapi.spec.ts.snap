            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "type": "string",
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
        },
        "required": [
          "id",
          "authorAccountId",
          "authorRole",
          "body",
          "createdAt",
        ],
        "type": "object",
      },
      "StaffLeadNoteRequest": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "body",
        ],
        "type": "object",
      },
      "StaffLeadTransitionRequest": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "to": {
            "enum": [
              "new",
              "verified",
              "assigned",
              "accepted",
              "contacted",
              "touring",
              "under_contract",
              "closed",
              "lost",
              "spam",
              "rejected",
            ],
            "type": "string",
          },
        },
        "required": [
          "to",
        ],
        "type": "object",
      },
      "StaffLeadTransitionResponse": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "enum": [
              "new",
              "verified",
              "assigned",
              "accepted",
              "contacted",
              "touring",
              "under_contract",
              "closed",
              "lost",
              "spam",
              "rejected",
            ],
            "type": "string",
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "to": {
            "enum": [
              "new",
              "verified",
              "assigned",
              "accepted",
              "contacted",
              "touring",
              "under_contract",
              "closed",
              "lost",
              "spam",
              "rejected",
            ],
            "type": "string",
          },
        },
        "required": [
          "id",
          "from",
          "to",
        ],
        "type": "object",
      },
      "StaffLeadUnassignRequest": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "note",
        ],
        "type": "object",
      },
      "StaffLeadsEnvelope": {
        "additionalProperties": false,
        "properties": {
          "nextCursor": {
            "nullable": true,
            "type": "string",
          },
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string",
                },
                "emailMasked": {
                  "nullable": true,
                  "type": "string",
                },
                "id": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                "kind": {
                  "enum": [
                    "message",
                    "tour_request",
                  ],
                  "type": "string",
                },
                "listingId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                "name": {
                  "nullable": true,
                  "type": "string",
                },
                "phoneMasked": {
                  "nullable": true,
                  "type": "string",
                },
                "possibleDuplicate": {
                  "type": "boolean",
                },
                "status": {
                  "enum": [
                    "new",
                    "verified",
                    "assigned",
                    "accepted",
                    "contacted",
                    "touring",
                    "under_contract",
                    "closed",
                    "lost",
                    "spam",
                    "rejected",
                  ],
                  "type": "string",
                },
                "verifiedAccount": {
                  "nullable": true,
                  "type": "boolean",
                },
              },
              "required": [
                "id",
                "createdAt",
                "kind",
                "status",
                "name",
                "emailMasked",
                "phoneMasked",
                "verifiedAccount",
                "listingId",
                "possibleDuplicate",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "results",
          "nextCursor",
        ],
        "type": "object",
      },
      "StaffMe": {
        "additionalProperties": false,
        "properties": {
          "roles": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "roles",
        ],
        "type": "object",
      },
      "UpdateAgentProfileRequest": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean",
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
          },
          "licenceNumber": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string",
          },
          "licenceStates": {
            "items": {
              "pattern": "^[A-Z]{2}$",
              "type": "string",
            },
            "maxItems": 60,
            "minItems": 1,
            "type": "array",
          },
        },
        "type": "object",
      },
      "ZipsResponse": {
        "additionalProperties": false,
        "properties": {
          "groups": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "count": {
                  "description": "Listing cards in the ZIP code.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "key": {
                  "description": "The five-digit ZIP code.",
                  "type": "string",
                },
                "previewPhotos": {
                  "description": "Up to 5 primary photos, one per listing card of the group, newest listed first. A listing whose media display is suppressed adds none. Absent when no listing qualifies.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "listingId": {
                        "description": "The listing the photo belongs to.",
                        "type": "string",
                      },
                      "url": {
                        "description": "The listing’s primary photo URL.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "url",
                      "listingId",
                    ],
                    "type": "object",
                  },
                  "maxItems": 5,
                  "type": "array",
                },
              },
              "required": [
                "key",
                "count",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "listingTotal": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "total": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
        },
        "required": [
          "groups",
          "total",
          "listingTotal",
        ],
        "type": "object",
      },
    },
  },
  "info": {
    "description": "\`property-service\`'s HTTP API. The service owns the Communities → Properties → Units → Listings hierarchy; \`listings\` is the resource this version of the document exposes, and a later resource extends THIS document rather than publishing a second one — the aggregation key is part of the docs URL, so splitting would break every bookmark. Every response carries the full broker/office attribution block (NAR 7.58, PRD §6.2), there is no field-selection parameter, and unknown query parameters are rejected with 400 — so no caller can omit it. Results are read through a compliance-enforcing view that applies two distinct seller opt-outs. A listing withheld from internet display is absent entirely: omitted from search results and from \`total\`, and indistinguishable from an unknown id on detail (the same 404, byte for byte). A listing whose street address is withheld is still returned, with \`address\`, \`latitude\` and \`longitude\` null together and \`unit.unitNumber\` withheld on detail, so the address cannot be reconstructed; such rows remain in \`total\` and simply have no map coordinates — never substitute a city or ZIP centroid for them. Free-text \`query\` matches title, address, city, neighborhood and zip — never the description, which is third-party MLS remarks carrying a moderation state; making it searchable would allow keyword-based steering on protected-class language (PRD §6.3). A seller may also suppress price, photos, days on market or price history individually (#53) while the listing stays syndicated; a field withheld this way is null (or, for photos, reduced to at most one image), and the listing remains in results and in \`total\`. See the \`minPrice\`/\`maxPrice\`/\`sort\` parameter descriptions for how a seller-suppressed price interacts with range filters and ordering.",
    "title": "Property Service",
    "version": "1.0.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/agent/leads": {
      "get": {
        "description": "Requires the Agent role and an active agent profile. Only leads with an open assignment to the caller profile. Newest assignment first, at most 200. Email and phone are masked in every row. \`emailMasked\` is null when the account contact is unavailable. The response is \`private, no-store\`.",
        "operationId": "listAgentLeads",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "new",
                "verified",
                "assigned",
                "accepted",
                "contacted",
                "touring",
                "under_contract",
                "closed",
                "lost",
                "spam",
                "rejected",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentLeadsEnvelope",
                },
              },
            },
            "description": "The leads assigned to the caller.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Invalid or unknown parameter or body field (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "My leads, for an agent",
      },
    },
    "/agent/leads/{id}": {
      "get": {
        "description": "Requires the Agent role and an active agent profile. \`contact\` is null while the status is \`assigned\`. Accept reveals it. \`contact.name\` and \`contact.email\` are null when the account contact is unavailable. Every read writes an access-audit row. A lead that is not assigned to the caller answers 404, never 403.",
        "operationId": "getAgentLead",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentLeadDetail",
                },
              },
            },
            "description": "The lead.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No lead has this id (\`not_found\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "One lead of the caller",
      },
    },
    "/agent/leads/{id}/accept": {
      "post": {
        "description": "Requires the Agent role and an active agent profile. Moves \`assigned\` to \`accepted\` and records the accept time. The request has no body.",
        "operationId": "acceptAgentLead",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentLeadTransitionResponse",
                },
              },
            },
            "description": "The lead moved to \`accepted\`.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No lead has this id (\`not_found\`).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The lead is not \`assigned\` (\`conflict\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Accept an assigned lead",
      },
    },
    "/agent/leads/{id}/decline": {
      "post": {
        "description": "Requires the Agent role and an active agent profile. The reason comes from a fixed list. The assignment ends with \`declined\` and the lead returns to \`verified\` for staff to match again. Allowed only while the status is \`assigned\`.",
        "operationId": "declineAgentLead",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentLeadDeclineRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentLeadTransitionResponse",
                },
              },
            },
            "description": "The lead returned to \`verified\`.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Invalid or unknown parameter or body field (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No lead has this id (\`not_found\`).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The lead is not \`assigned\` (\`conflict\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Decline an assigned lead",
      },
    },
    "/agent/leads/{id}/status": {
      "post": {
        "description": "Requires the Agent role and an active agent profile. The transitions table decides the order: \`contacted\`, \`touring\`, \`under_contract\`, \`closed\` or \`lost\`. The lead must be accepted first. \`closed\` and \`lost\` end the assignment. Each change writes a status event with the agent as actor.",
        "operationId": "updateAgentLeadStatus",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentLeadStatusRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentLeadTransitionResponse",
                },
              },
            },
            "description": "The lead moved to the new status.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Invalid or unknown parameter or body field (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No lead has this id (\`not_found\`).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The lead is not accepted, or the transitions table does not allow the change (\`conflict\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Move an accepted lead forward",
      },
    },
    "/listings": {
      "get": {
        "description": "Sorted with a deterministic total order, so paging is stable. \`listingType=all\` covers currently marketed listings and excludes sold; ask for \`sold\` explicitly.

This is a SEARCH surface, not a bulk-export surface. Paging depth is bounded: \`(page - 1) * pageSize\` must not exceed 10000, so at the default page size of 20 the deepest reachable page is 501. A request past that window is rejected with 400 and the error code \`result_window_exceeded\` — it is never silently clamped to the last valid page, and never answered with an empty 200. There is no parameter that lifts the bound. To reach listings outside the window, narrow the search with filters; retrieving the whole set is not a supported operation.

The bound is on depth alone — no filter is required, and an unfiltered search is a supported browse path. It is also independent of the past-the-end rule: a page beyond the last result but INSIDE the window is a normal 200 with an empty \`results\` array. \`total\` is always the exact count of the full filtered set, even when that count exceeds the window — it is never clamped to it.

The optional \`bounds\` limits the result to a viewport. It is ANDed with every other filter, so the result is the searched place within the viewport. A listing whose street address is withheld has no coordinates, so it is not in a viewport result.

The optional \`area\` is a drawn GeoJSON Polygon. Only listings inside it match. It is ANDed with every other filter, including \`boundary\` and \`bounds\`. A self-intersecting or zero-area shape is a 400.

A signed-in request also gets \`isSaved\` and \`isFavorited\` on each result, resolved by home, and a \`private, no-store\` response. A signed-out request never gets them and is never rejected for lacking a credential.",
        "operationId": "searchListings",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "zip",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "street",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "description": "Case-insensitive EXACT match, not substring — a place name, not a search term. ANDed with every other filter, including \`query\`. Mirrors \`neighborhood\`: a substring match would make \`Ken\` match \`Kensington\`.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "description": "Two-letter state code, case-insensitive exact match (e.g. \`MD\`). ANDed with every other filter, including \`query\` — no parameter suppresses another. Full state names are the client’s job to normalize before sending this parameter.",
              "pattern": "^[A-Za-z]{2}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "listingType",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "sale",
                "rent",
                "sold",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "propertyType",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values: Single Family, Condo, Townhome, Multi-Family, Loft, Land, New Construction, Manufactured/Mobile. 'all' means every type.",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Active, Coming Soon, Pending. Default when omitted or empty: Active, Coming Soon. 'Pending' means "Under Contract" to consumers. It covers both the Active Under Contract and Pending MLS statuses. Sold is not a value here. No sold listing publishes in search yet.",
            },
          },
          {
            "in": "query",
            "name": "minPrice",
            "required": false,
            "schema": {
              "description": "Whole number. A listing with a seller-suppressed price never matches this filter, because it has no price to compare.",
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "description": "Whole number. A listing with a seller-suppressed price never matches this filter, because it has no price to compare.",
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "beds",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "baths",
            "required": false,
            "schema": {
              "pattern": "^\\d+(\\.5)?$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minSqft",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "neighborhood",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "officeKey",
            "required": false,
            "schema": {
              "description": "The listing office, by its MLS office key. A drill-down from a broker group, not a search box. \`unlisted\` matches the listings that carry no office key. It is an exact match, ANDed with every other filter.",
              "pattern": "^(\\d{1,19}|unlisted)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "county",
            "required": false,
            "schema": {
              "description": "A 5-digit county FIPS code, matched exactly (case-insensitive) against county_fips. ANDed with every other filter. A caller without a FIPS code should send \`boundary\` instead — this and \`boundary\` should not both be sent for the same conceptual place.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "boundary",
            "required": false,
            "schema": {
              "description": "GeoJSON Polygon or MultiPolygon, as a JSON string, simplified client-side. ANDs with \`neighborhood\` when both are sent. Capped at 500 points and 20000 characters.",
              "maxLength": 20000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "area",
            "required": false,
            "schema": {
              "description": "A drawn shape: GeoJSON Polygon as a JSON string, one closed ring. Only listings inside it match. ANDed with every other filter, including \`boundary\` and \`bounds\`. A listing whose street address is withheld has no coordinates and never matches. Capped at 200 points, 8000 characters and 20 degrees across. A self-intersecting or zero-area shape is a 400.",
              "maxLength": 8000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "bounds",
            "required": false,
            "schema": {
              "description": "Viewport as \`west,south,east,north\` in decimal degrees. West must be less than east and south less than north. A listing whose seller withheld the address has no coordinates, so it never matches a viewport.",
              "pattern": "^-?\\d+(\\.\\d+)?(,-?\\d+(\\.\\d+)?){3}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "openHouse",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "newConstruction",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "waterfront",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "petFriendly",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "explode": false,
            "in": "query",
            "name": "amenities",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Pool, Garage, Gym, Elevator, Balcony, Fireplace, Washer/Dryer, Pet Friendly, Waterfront, Office, Rooftop, Garden, Smart Home, Solar, EV Charging.",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "listedWithinDays",
            "required": false,
            "schema": {
              "description": "Whole number, 1 to 30. Matches a listing whose listed_at is within this many days of now. A listing with no listed_at (the feed carried no list date) never matches.",
              "pattern": "^([1-9]|[12][0-9]|30)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "priceReduced",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "skipTotal",
            "required": false,
            "schema": {
              "description": "When true, the server skips the exact match count. \`total\` then holds the number of results on this page and \`pageCount\` is 1 for a non-empty page, so neither says how many listings match. Use it for a short list that never pages.",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "recommended",
              "description": "\`price-asc\` and \`price-desc\` place a listing with a seller-suppressed price (#53) LAST, regardless of direction — \`NULLS LAST\` on both, not the SQL default of \`NULLS FIRST\` on DESC. A suppressed-price row is never lost from the result, only ordered after every row that has a price.",
              "enum": [
                "recommended",
                "newest",
                "newly-listed",
                "price-asc",
                "price-desc",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Whole number, 1 or greater. Default 1. Paging depth is bounded: (page - 1) * pageSize must not exceed 10000, and a request past that returns 400. The bound is not expressed as a maximum on this parameter because the deepest valid page depends on pageSize (501 at the default page size of 20).",
              "pattern": "^[1-9]\\d*$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 100. Default 20.",
              "pattern": "^([1-9][0-9]?|100)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingsEnvelope",
                },
              },
            },
            "description": "A page of listings with an exact total.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unknown or invalid query parameter (\`invalid_request\`), or a page past the reachable result window (\`result_window_exceeded\`). The two carry different error codes because they call for different responses: the first means a parameter needs fixing, the second that the search needs narrowing — retrying the same request will never succeed.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "Search listings",
      },
    },
    "/listings/brokers": {
      "get": {
        "description": "The listings of a search, grouped by listing office. The request takes the \`GET /listings\` filters. Each group counts the listing cards that search returns, so the group counts add up to the search total. The group key is the MLS office key. The name is the office name of the most recently updated listing in the group. Listings with no office key form one group with the key \`unlisted\`. Order by \`count\` (default) or \`name\`. Ties break by \`key\`. No office is ranked, featured or left out. \`minCount\` defaults to 1. Page with \`limit\` and \`offset\`.",
        "operationId": "getBrokerGroups",
        "parameters": [
