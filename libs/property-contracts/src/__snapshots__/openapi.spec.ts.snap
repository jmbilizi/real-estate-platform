    "/staff/leads": {
      "get": {
        "description": "Requires the Admin, SuperAdmin or Moderator role. Newest first, cursor paging, page size capped at 50. Email and phone are masked. Name and email come from the buyer account. They are null when the account contact is unavailable. A row has \`possibleDuplicate\` when another open request on the same listing came within seven days from the same buyer account or phone. The server never merges leads. The response is \`private, no-store\`.",
        "operationId": "listStaffLeads",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "new",
                "verified",
                "assigned",
                "accepted",
                "contacted",
                "touring",
                "under_contract",
                "closed",
                "lost",
                "spam",
                "rejected",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "enum": [
                "message",
                "tour_request",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "createdFrom",
            "required": false,
            "schema": {
              "description": "Inclusive lower bound on the creation time. ISO 8601 with a zone.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "createdTo",
            "required": false,
            "schema": {
              "description": "Exclusive upper bound on the creation time. ISO 8601 with a zone.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "listingId",
            "required": false,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 50. Default 25.",
              "pattern": "^([1-9]|[1-4][0-9]|50)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "The \`nextCursor\` of the previous page. Opaque.",
              "maxLength": 200,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffLeadsEnvelope",
                },
              },
            },
            "description": "A page of leads.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Invalid or unknown parameter or body field (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Buyer requests, for staff",
      },
    },
    "/staff/leads/metrics": {
      "get": {
        "description": "Requires the Admin, SuperAdmin or Moderator role. Counts by status and kind, the median and 90th percentile time to verify, assign and accept, and the count of aging leads. \`from\` and \`to\` bound the lead creation time and apply to every value. Durations come from the status events. A duration is null when no lead made the step. The response holds no personal data and is \`private, no-store\`.",
        "operationId": "getStaffLeadMetrics",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "description": "Inclusive lower bound on the lead creation time. ISO 8601 with a zone.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "description": "Exclusive upper bound on the lead creation time. ISO 8601 with a zone.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffLeadMetrics",
                },
              },
            },
            "description": "The metrics.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Invalid or unknown parameter or body field (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "A valid credential with none of the allowed roles (\`forbidden\`).",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Lead desk metrics",
      },
    },
    "/staff/leads/{id}": {
