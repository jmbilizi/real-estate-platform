    "/staff/leads/{id}/assign": {
      "post": {
        "description": "Requires the Admin, SuperAdmin or Moderator role. The lead must be \`verified\`. The agent must be active and licensed in the state of the listing. Only the licence state and the listing state decide a match. The request has no reason field. The lead moves to \`assigned\` and the assignment is recorded.",
        "operationId": "assignStaffLead",
