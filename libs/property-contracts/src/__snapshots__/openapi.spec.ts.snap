              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "description": "Case-insensitive EXACT match, not substring — a place name, not a search term. ANDed with every other filter, including \`query\`. Mirrors \`neighborhood\`: a substring match would make \`Ken\` match \`Kensington\`.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "state",
