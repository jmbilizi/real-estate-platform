  "info": {
    "description": "Consumer listings search and detail. Every response carries the full broker/office attribution block (NAR 7.58, PRD §6.2); no parameter can omit it. Results are read through a compliance-enforcing view, so seller-suppressed listings are absent rather than redacted. Free-text \`query\` matches title, address, city, neighborhood and zip — never the description.",
    "title": "Cribstop Listings API",
    "version": "1.0.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/listings": {
      "get": {
        "description": "Sorted with a deterministic total order, so paging is stable. \`listingType=all\` covers currently marketed listings and excludes sold; ask for \`sold\` explicitly.",
        "operationId": "searchListings",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "zip",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "street",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "listingType",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "sale",
                "rent",
                "sold",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "propertyType",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "Single Family",
                "Condo",
                "Townhome",
                "Multi-Family",
                "Loft",
                "Land",
                "New Construction",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minPrice",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "beds",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "baths",
            "required": false,
            "schema": {
              "pattern": "^\\d+(\\.5)?$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minSqft",
            "required": false,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "neighborhood",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "openHouse",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "newConstruction",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "waterfront",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "petFriendly",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "explode": false,
            "in": "query",
            "name": "amenities",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Pool, Garage, Gym, Elevator, Balcony, Fireplace, Washer/Dryer, Pet Friendly, Waterfront, Office, Rooftop, Garden, Smart Home, Solar, EV Charging.",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "recommended",
              "enum": [
                "recommended",
                "newest",
                "price-asc",
                "price-desc",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Whole number, 1 or greater. Default 1.",
              "pattern": "^[1-9]\\d*$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 100. Default 20.",
              "pattern": "^([1-9][0-9]?|100)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingsEnvelope",
                },
              },
            },
            "description": "A page of listings with an exact total.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unknown or invalid query parameter.",
          },
        },
        "summary": "Search listings",
      },
    },
    "/listings/meta": {
      "get": {
        "description": "Callable without running a search. \`dataUpdatedAt\` is MLS feed freshness, not the time ingestion ran, and is null when nothing is publishable.",
        "operationId": "getListingsMeta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingsMeta",
                },
              },
            },
            "description": "Dataset freshness and provenance.",
          },
        },
        "summary": "Dataset freshness",
      },
    },
    "/listings/{id}": {
      "get": {
        "description": "Returns the object graph. \`unit\` is null for a non-subdivided home — meaningful, not missing. Unknown, removed and seller-suppressed listings are indistinguishable.",
        "operationId": "getListing",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingDetail",
                },
              },
            },
            "description": "The listing.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such listing.",
          },
        },
        "summary": "Listing detail",
      },
    },
  },
}
`;
