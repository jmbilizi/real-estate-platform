    "/properties/lookup": {
      "get": {
        "description": "Takes the two segments of /<city>-<st>/<address-slug>. On a local miss the service reads that one address from the MLS across all statuses, then resolves again.",
        "operationId": "lookupProperty",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "address",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyLookupResponse",
                },
              },
            },
            "description": "One or more matches. More than one means the path is ambiguous.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The segments do not form a property path.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No property at that address.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "Resolve a property path to listings",
      },
    },
    "/properties/{id}/page": {
      "get": {
        "description": "The id is the unit id in a subdivided building, else the property id. The response carries the canonical path and slug, the status label, the display flags, the latest listing, the compliance-filtered history, nearby active listings and SEO text. An Off market home returns the property record only, with latestListing null.",
        "operationId": "getPropertyPage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
