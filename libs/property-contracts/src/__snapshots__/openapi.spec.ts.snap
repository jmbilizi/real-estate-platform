            "explode": false,
            "in": "query",
            "name": "amenities",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "Comma-separated or repeated values from the closed set: Pool, Garage, Gym, Elevator, Balcony, Fireplace, Washer/Dryer, Pet Friendly, Waterfront, Office, Rooftop, Garden, Smart Home, Solar, EV Charging.",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "listedWithinDays",
            "required": false,
            "schema": {
              "description": "Whole number, 1 to 30. Matches a listing whose listed_at is within this many days of now. A listing with no listed_at (the feed carried no list date) never matches.",
              "pattern": "^([1-9]|[12][0-9]|30)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "priceReduced",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "minCount",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 1000. Default 1. A group with fewer listings is omitted. A value above 1 makes the group counts add up to less than \`listingTotal\`.",
              "pattern": "^([1-9]\\d{0,2}|1000)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 100. Default 24.",
              "pattern": "^([1-9][0-9]?|100)$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "description": "Whole number from 0 to 10000. Default 0. Skips this many groups in the order given by \`order\`. \`total\` stays the exact group count.",
              "pattern": "^\\d{1,5}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "count",
              "description": "\`count\` (default): listing count descending. \`name\`: name ascending. Ties break by \`key\`. No other order exists.",
