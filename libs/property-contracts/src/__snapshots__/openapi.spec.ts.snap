        "summary": "Everything the property page renders, in any market status",
      },
    },
    "/saved-homes": {
      "get": {
        "description": "Requires sign-in. Returns only the calling account’s homes, newest save first. Each row is a home: the property facts plus its current consumer-visible listing, or \`listing\` null when it has none. An off-market home is a normal row, never a 404 and never left out. Address and coordinates carry the same masking as search. The response is \`private, no-store\`.",
        "operationId": "listSavedHomes",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 9999999. Default 1.",
              "pattern": "^[1-9]\\d{0,6}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Whole number from 1 to 100. Default 20.",
              "pattern": "^([1-9][0-9]?|100)$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedHomesEnvelope",
                },
              },
            },
            "description": "A page of saved homes with an exact total.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unknown or invalid query parameter (\`invalid_request\`).",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "The saved homes of the signed-in account",
      },
    },
    "/saved-homes/{id}": {
      "delete": {
        "description": "Requires sign-in. \`id\` is the \`propertyId\` of a saved home. It works for a home with no consumer-visible listing. Removing a home that is not saved is a success with \`saved\` false. A request never touches another account’s saves.",
        "operationId": "unsaveHome",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string",
