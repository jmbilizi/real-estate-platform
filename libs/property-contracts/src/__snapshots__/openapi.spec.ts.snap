              },
            },
            "description": "The property page.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such home.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
