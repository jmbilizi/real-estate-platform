          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No such listing.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
        },
        "summary": "Property page of the home that one listing is on",
      },
    },
    "/listings/{id}/saved": {
      "delete": {
        "description": "Requires sign-in. Removing a home that is not saved is a success with \`saved\` false.",
