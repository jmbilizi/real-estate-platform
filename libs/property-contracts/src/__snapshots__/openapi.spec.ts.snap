                },
              },
            },
            "description": "The home is not saved.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "No valid credential. The body gives no reason.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "The id is not a well-formed id.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "Unexpected server error. The body carries no detail by design.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody",
                },
              },
            },
            "description": "account-service did not answer, so the session is unknown. Retry. This is not a sign-out.",
          },
        },
        "summary": "Remove a saved home by its home id",
      },
    },
    "/staff/agents": {
      "get": {
        "description": "Requires the Admin, SuperAdmin or Moderator role. Every profile, ordered by display name. The response is \`private, no-store\`.",
